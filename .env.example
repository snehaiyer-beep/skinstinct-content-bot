# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.85

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your personal chat id (or an admin group) — draft approvals and error alerts go here
TELEGRAM_ADMIN_CHAT_ID=
# Channel/group id content gets published to once approved (leave blank until ready to go live)
TELEGRAM_CHANNEL_ID=

# Which file in voice_skills/ is the active persona (without .txt)
ACTIVE_VOICE_SKILL=meera_skinstinct

# Regeneration attempts before a draft is flagged for human review instead of auto-retried
MAX_GENERATION_ATTEMPTS=3

LOG_LEVEL=INFO
