# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.85

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your personal chat id (or an admin group) — draft approvals and error alerts go here
TELEGRAM_ADMIN_CHAT_ID=
# Channel/group id content gets published to once approved (leave blank until ready to go live)
TELEGRAM_CHANNEL_ID=
# Random string Telegram echoes back on every webhook call, checked in api/index.py
# so random internet requests to your public /api/webhook URL are rejected.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Supabase — durable storage for drafts/history/queue (SQLite doesn't survive
# between separate serverless requests on Vercel, so this is required in prod)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Your deployed Vercel URL (e.g. https://skinstinct-content-bot.vercel.app) —
# used only by scripts/set_webhook.py to tell Telegram where to send updates.
PUBLIC_URL=

# Which file in voice_skills/ is the active persona (without .txt)
ACTIVE_VOICE_SKILL=meera_skinstinct

# Regeneration attempts before a draft is flagged for human review instead of auto-retried
MAX_GENERATION_ATTEMPTS=3

LOG_LEVEL=INFO
